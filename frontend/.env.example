# ── Frontend environment variables (Vite) ────────────────────────────────────
# Copy to .env.local for local dev.
# On Netlify, set these in: Site Settings → Environment Variables

# Leave empty in development — Vite proxy handles /api automatically.
# In production set this to your Railway backend URL:
# e.g. https://telegram-referral-backend.up.railway.app/api
VITE_API_URL=
